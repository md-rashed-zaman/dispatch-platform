# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres (local Docker Compose)
POSTGRES_DB=dispatch
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=change-me
# Password of dispatch_app, the role the app itself connects as (created by migration V4)
DB_APP_PASSWORD=change-me

# Keycloak admin (local only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Gemini API key from Google AI Studio (needed from Phase 3)
GEMINI_API_KEY=

# S3-compatible storage (SeaweedFS locally, needed from step 1.7). The keys must match an identity in
# infra/compose/seaweedfs/s3.json; leave them empty to use its local defaults.
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dispatch-media
